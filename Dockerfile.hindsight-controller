# syntax=docker/dockerfile:1.7

# Build the generic one-shot Hindsight controller. The image contains no
# storage topology, endpoints, transcripts, or credentials; the operator pins
# the source commit and supplies those through its own Compose configuration.
FROM rust:1.85-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src
RUN cargo build --release --bin agent-bookkeeper-hindsight-controller

FROM debian:bookworm-slim

RUN useradd --system --create-home --uid 1000 bookkeeper
COPY --from=builder /src/target/release/agent-bookkeeper-hindsight-controller /usr/local/bin/
USER bookkeeper

ENTRYPOINT ["/usr/local/bin/agent-bookkeeper-hindsight-controller"]

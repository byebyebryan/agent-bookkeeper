# syntax=docker/dockerfile:1.7

# Build the generic V1.5 one-shot controller, then layer it onto an
# operator-provided MemPalace image. The operator pins both inputs and supplies
# all paths, storage, and runtime configuration through Compose or equivalent.
FROM rust:1.85-slim AS bookkeeper-builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src
RUN cargo build --release --bin agent-bookkeeper-mempalace-controller

ARG MEMPALACE_IMAGE=mempalace:latest
FROM ${MEMPALACE_IMAGE}

USER root
COPY --from=bookkeeper-builder /src/target/release/agent-bookkeeper-mempalace-controller /usr/local/bin/
USER mempalace

ENTRYPOINT ["/usr/local/bin/agent-bookkeeper-mempalace-controller"]
